{
  "name": "midori-vpn-control",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint -- --max-warnings=0 && npm test && npm run build"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@vueuse/core": "14.4.0",
    "pinia": "4.0.3",
    "qrcode": "^1.5.4",
    "vue": "^3.5.35",
    "vue-router": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "^2.4.6",
    "eslint": "10.9.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "10.10.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.5.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "3.3.11"
  },
  "overrides": {
    "jiti": "^2.4.2",
    "js-beautify": "2.0.3"
  }
}
