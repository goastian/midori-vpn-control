{
  "name": "midori-vpn-control",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:i18n && vue-tsc --noEmit && vite build",
    "check:i18n": "vitest run src/__tests__/lib/i18n.spec.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "check": "npm run lint -- --max-warnings=0 && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "@vueuse/core": "15.0.0",
    "pinia": "4.1.0",
    "qrcode": "^1.5.4",
    "vue": "3.5.45",
    "vue-router": "5.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-vue": "10.12.1",
    "happy-dom": "21.0.4",
    "prettier": "^3.5.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "jiti": "^2.4.2",
    "js-beautify": "2.0.3",
    "glob": "14.0.6",
    "minimatch": "11.0.8"
  }
}
