# ── Stage 1: Build ──
FROM docker.io/library/node:22-alpine AS builder

WORKDIR /app
COPY package.json ./
RUN npm install

COPY . .

ARG VITE_API_URL
ARG VITE_AUTHENTIK_ISSUER
ARG VITE_AUTHENTIK_CLIENT_ID
ARG VITE_AUTHENTIK_REDIRECT_URI

RUN if [ -n "$VITE_API_URL" ]; then export VITE_API_URL="$VITE_API_URL"; fi && \
    if [ -n "$VITE_AUTHENTIK_ISSUER" ]; then export VITE_AUTHENTIK_ISSUER="$VITE_AUTHENTIK_ISSUER"; fi && \
    if [ -n "$VITE_AUTHENTIK_CLIENT_ID" ]; then export VITE_AUTHENTIK_CLIENT_ID="$VITE_AUTHENTIK_CLIENT_ID"; fi && \
    if [ -n "$VITE_AUTHENTIK_REDIRECT_URI" ]; then export VITE_AUTHENTIK_REDIRECT_URI="$VITE_AUTHENTIK_REDIRECT_URI"; fi && \
    npm run build

# ── Stage 2: Production Nginx Runtime ──
FROM docker.io/library/nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY .container/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
